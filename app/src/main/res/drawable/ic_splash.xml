<?xml version="1.0" encoding="utf-8"?>
<!-- Splash screen icon: the neon goat mark, sized to sit inside the system splash
     icon keyline (content within the centre two-thirds of the canvas). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- Left horn / chart line -->
    <path
        android:pathData="M166,286 L216,196 L256,246 L316,146"
        android:strokeWidth="24"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="166" android:startY="146"
                android:endX="346" android:endY="366"
                android:type="linear">
                <item android:color="#FFFF3366" android:offset="0.0" />
                <item android:color="#FFFF9933" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right horn / chart line -->
    <path
        android:pathData="M346,286 L296,196 L256,246"
        android:strokeWidth="24"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="166" android:startY="146"
                android:endX="346" android:endY="366"
                android:type="linear">
                <item android:color="#FFFF3366" android:offset="0.0" />
                <item android:color="#FFFF9933" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Goat face abstract triangle -->
    <path
        android:pathData="M256,256 L196,366 L316,366 Z"
        android:strokeWidth="24"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="166" android:startY="146"
                android:endX="346" android:endY="366"
                android:type="linear">
                <item android:color="#FFFF3366" android:offset="0.0" />
                <item android:color="#FFFF9933" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Tracking dot at the peak -->
    <path
        android:pathData="M316,146 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 Z"
        android:fillColor="#FFFF9933" />
</vector>
