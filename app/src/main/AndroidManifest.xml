<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- connect-client declares minSdk 26; the app stays at 24. Safe because every Health Connect
         call is gated on API 28+ at runtime (HealthConnectWeightProvider.isSupported). -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Health Connect: read-only access to the user's body weight (opt-in sync in settings). -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <!-- Needed to query the Health Connect provider's availability on Android 11+. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- In-app self-update: fetch the version metadata + download the APK over HTTPS, then hand the
         downloaded package to the system installer. REQUEST_INSTALL_PACKAGES is required since the
         app installs an APK itself (distribution is off-store). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The rest-timer backup alarm is inexact (setAndAllowWhileIdle), so no exact-alarm permission
         is needed — this avoids the Play-policy restrictions on SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM.
         The foreground service drives the precise finish while the process is alive; the inexact
         alarm is only the fallback if the process was killed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoatTracker.Splash">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect (Android 13-) opens this when the user taps our privacy rationale. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Same rationale entry point for Android 14+, which uses the system intent instead. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        
        <!-- Exposes the downloaded APK (in cacheDir/updates) to the system package installer as a
             content:// URI. file:// URIs are illegal since API 24 (FileUriExposedException). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver android:name=".ui.live.RestTimerReceiver" android:exported="false" />
        
        <service
            android:name=".ui.live.RestTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Workout rest timer countdown for fitness tracking" />
        </service>
    </application>

</manifest>
